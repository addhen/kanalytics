import kotlin.String;
import kotlin.Any;
import kotlin.collections.Map;
import kotlinx.datetime.Instant;

PRAGMA user_version = 3;

-- create
CREATE TABLE IF NOT EXISTS `event_data` (
  `id` INTEGER PRIMARY KEY AUTOINCREMENT,
  `event_name` TEXT NOT NULL,
  `tracker_name` TEXT NOT NULL,
  `event_description` TEXT DEFAULT NULL,
  `event_created_date` TEXT AS Instant NOT NULL,
  `event_properties` TEXT AS Map<String, Any> NOT NULL
);

CREATE INDEX IF NOT EXISTS index_event_data_event_name ON event_data (event_name);
CREATE INDEX IF NOT EXISTS index_event_data_tracker_name ON event_data (tracker_name);
CREATE INDEX IF NOT EXISTS index_event_data_event_created_date ON event_data (event_created_date);
CREATE INDEX IF NOT EXISTS index_event_data_event_description ON event_data (event_description);

-- insert
insertEventData:
INSERT OR REPLACE INTO `event_data`(
  `event_name`,
  `event_description`,
  `tracker_name`,
  `event_created_date`,
  `event_properties`
) VALUES (
  ?,
  ?,
  ?,
  ?,
  ?
);

-- queries
getAllEventData:
SELECT * FROM `event_data` ORDER BY event_created_date DESC;

deleteAllEventData:
DELETE FROM `event_data`;

deleteAllEventDataOlderThan:
DELETE FROM `event_data` WHERE event_created_date < :date;

-- search
-- Create a virtual table for full-text search
CREATE VIRTUAL TABLE event_data_index USING fts4(
  event_name,
  tracker_name,
  event_properties
);

-- Trigger to insert data into the virtual table on insert
CREATE TRIGGER event_data_index_insert_trigger
AFTER INSERT ON event_data
BEGIN
  INSERT INTO event_data_index (docid, event_name, tracker_name, event_properties)
  VALUES (new.id, new.event_name, new.tracker_name, new.event_properties);
END;

