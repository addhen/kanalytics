-- Trigger to delete from the virtual table on delete
CREATE TRIGGER event_data_delete_trigger
AFTER DELETE ON event_data
BEGIN
  DELETE FROM event_data_index WHERE docid = old.id;
END;

-- Search query
searchEvents:
SELECT event_data.*
FROM event_data_index
JOIN event_data ON (event_data_index.docid = event_data.id)
WHERE event_data_index MATCH :query || '*'
ORDER BY event_created_date DESC;
